{
  "name": "diegoquintanadeitu",
  "type": "module",
  "version": "2025.06.13",
  "private": true,
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "a11y": "npm run build && npm run preview & sleep 5 && npx tsx src/scripts/accessibility-test.ts",
    "a11y:ci": "npx tsx src/scripts/accessibility-test.ts",
    "a11y:quick": "npx tsx src/scripts/accessibility-test.ts",
    "test:theme": "npx tsx src/scripts/theme-regression-test.ts",
    "type-check": "tsc --noEmit",
    "type-check:all": "npm run type-check",
    "test:build": "npm run type-check:all && npm run build",
    "test:full": "npm run test:build && npm run preview & sleep 5 && npm run a11y:quick",
    "clean": "rm -rf dist .astro node_modules/.vite"
  },
  "dependencies": {
    "@midudev/tailwind-animations": "0.2.0",
    "@tailwindcss/vite": "4.1.13",
    "astro": "5.13.10",
    "tailwindcss": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@tailwindcss/typography": "0.5.18",
    "@types/node": "24.5.2",
    "axe-core": "4.10.3",
    "lighthouse": "12.8.2",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "^6.0.3"
  }
}
