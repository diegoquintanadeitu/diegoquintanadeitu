---
import { api } from "@/services/api";
import Layout from "@/ui/layouts/Layout.astro";
import BackButton from "@/ui/components/BackButton.astro";
import { cvTranslationsEn } from "@/db/translations";

// Obtener datos
const profile = await api.getProfile();
const timeline = await api.getTimeline();
const projects = await api.getProjects();
const skillCategories = await api.getSkills();
const education = await api.getEducation();

// Helper para procesar markdown simple
const processMarkdown = (text: string) => {
  return text
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
    .replace(/\*(.*?)\*/g, "<em>$1</em>");
};
---

<script is:inline>
  localStorage.setItem("portfolio-theme", "light");
</script>

<Layout
  title={`Curriculum Vitae - ${profile.name}`}
  description={`Curriculum Vitae de ${profile.name}, ${profile.role} con experiencia en TypeScript, React, Next.js y equipos ágiles. Disponible para proyectos remotos en LATAM.`}
  showFooter={false}
  showThemeSelector={false}
>
  <style>
    @media print {
      body {
        margin: 0 !important;
        padding: 0 !important;
        font-size: 11px !important;
        line-height: 1.15 !important;
      }
      .print-break {
        page-break-before: always;
      }
      .print-avoid-break {
        page-break-inside: avoid;
      }
    }
  </style>

  <div class="bg-[#f5f5f5] min-h-screen pb-8 max-md:px-2">
    <!-- Navegación y acciones -->
    <div
      class="print:hidden sticky top-0 left-0 right-0 z-40 bg-[rgba(245,245,245,0.95)] backdrop-blur-[10px] border-b border-gray-300 p-4 mb-8 max-md:p-3 max-md:mb-4"
    >
      <div class="flex flex-col sm:flex-row gap-3 max-w-6xl mx-auto">
        <BackButton variant="secondary" />

        <button
          id="print-btn"
          class="bg-violet-800 hover:bg-violet-600 text-white px-6 py-3 rounded-lg font-medium flex items-center gap-2 justify-center sm:justify-start cursor-pointer btn-scale-animation"
          title="Imprimir Curriculum Vitae"
        >
          <svg
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
            ></path>
          </svg>
          <span data-i18n="printCV">Imprimir CV</span>
        </button>

        <button
          id="lang-toggle"
          class="bg-teal-700 hover:bg-teal-600 text-white px-4 py-3 rounded-lg font-medium flex items-center gap-2 justify-center sm:justify-start cursor-pointer btn-scale-animation"
          title="Cambiar idioma / Change language"
        >
          <svg
            class="w-4 h-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
            ></path>
          </svg>
          <span id="lang-label">EN</span>
        </button>
      </div>
    </div>

    <div
      class="max-w-[21cm] min-h-[29.7cm] mx-auto p-4 shadow-[0_4px_20px_rgba(0,0,0,0.15)] bg-white rounded-[4px] print:shadow-none print:mx-[1.27cm] print:max-w-none print:bg-white print:rounded-none max-md:mx-0 max-md:shadow-[0_2px_8px_rgba(0,0,0,0.1)] max-md:rounded-none"
    >
      <div>
        <header
          class="text-left border-b-2 border-blue-600 pb-2 mb-6 print-avoid-break"
        >
          <h1 class="text-3xl font-bold text-blue-800 mb-0 print:text-2xl">
            {profile.name}
          </h1>
          <h2 class="text-xl text-gray-600 mb-0 print:text-base">
            {profile.role}
          </h2>
          <span class="flex flex-row mt-0 items-center text-sm font-bold"
            >+543794141245</span
          >
          <span class="flex flex-row items-center text-sm font-bold"
            >Corrientes, Argentina</span
          >
          <div
            class="flex flex-col my-2 gap-2 justify-left text-sm text-gray-700 print:text-xs"
          >
            <div class="flex flex-row items-center">
              <span class="print:hidden mr-1">🔗 </span>
              diegoquintanadeitu.github.io
            </div>
            <div class="flex flex-row items-center">
              <span class="print:hidden mr-1">📫 </span>
              diegoquintanadeitu@gmail.com
            </div>
            <div class="flex flex-row items-center">
              <span class="print:hidden mr-1">🐙 </span>
              github.com/diegoquintanadeitu
            </div>
            <div class="flex flex-row items-center">
              <span class="print:hidden mr-1">👨🏻‍💻 </span>
              linkedin.com/in/diego-daniel-martin-quintana
            </div>
          </div>
        </header>

        <!-- Perfil Profesional -->
        <section
          class="mb-6 pb-6 border-b-2 border-blue-600 print-avoid-break print:mb-4"
        >
          <div
            class="space-y-3 text-sm text-justify leading-relaxed print:space-y-2 print:text-xs"
          >
            {
              profile.bio.map((paragraph, i) => (
                <p
                  set:html={processMarkdown(paragraph)}
                  data-es={processMarkdown(paragraph)}
                  data-en={processMarkdown(
                    cvTranslationsEn.bio[i] ?? paragraph,
                  )}
                />
              ))
            }
          </div>
        </section>

        <!-- Experiencia Profesional -->
        <section class="mb-8 print:mb-4">
          <div class="space-y-5">
            {
              timeline.map((job, jobIdx) => (
                <div class="print-avoid-break">
                  <div class="flex justify-between items-baseline mb-1">
                    <h4 class="font-bold text-blue-700 print:text-sm">
                      {job.title}
                    </h4>
                    <span class="text-sm text-gray-600 font-medium print:text-xs">
                      {job.period}
                    </span>
                  </div>
                  {job.company && (
                    <p class="text-sm text-gray-600 font-medium mb-2 print:text-xs print:mb-1">
                      {job.company}
                    </p>
                  )}
                  <p
                    class="text-sm text-justify leading-relaxed mb-2 print:text-xs print:mb-1"
                    set:html={processMarkdown(job.description)}
                    data-es={processMarkdown(job.description)}
                    data-en={processMarkdown(
                      cvTranslationsEn.timeline[jobIdx]?.description ??
                        job.description,
                    )}
                  />
                  {job.achievements && (
                    <div class="text-xs text-gray-600 bg-blue-50 p-2 rounded border-l-2 border-blue-300 print:p-1 print:text-xs">
                      <span
                        class="font-semibold block mb-1"
                        data-i18n="keyAchievements"
                      >
                        Logros destacados:
                      </span>
                      {job.achievements.map((achievement, achIdx) => (
                        <span
                          class="block"
                          set:html={`- ${processMarkdown(achievement)}`}
                          data-es={`- ${processMarkdown(achievement)}`}
                          data-en={`- ${processMarkdown(cvTranslationsEn.timeline[jobIdx]?.achievements[achIdx] ?? achievement)}`}
                        />
                      ))}
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </section>

        <!-- Habilidades Técnicas -->
        <section class="mb-8 print-avoid-break print:mb-4">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
            data-i18n="technicalSkills"
          >
            Habilidades Técnicas
          </h3>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 print:grid-cols-3 print:gap-2"
          >
            <!-- Lenguajes -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillLanguages"
              >
                Lenguajes
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.languages.map((s) => (
                    <span class="bg-blue-50 text-blue-800 px-2.5 py-0.5 rounded-full text-xs border border-blue-200 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- Frameworks y Bibliotecas -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillFrameworks"
              >
                Frameworks y Bibliotecas
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.frameworks.map((s) => (
                    <span class="bg-indigo-50 text-indigo-800 px-2.5 py-0.5 rounded-full text-xs border border-indigo-200 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- Testing -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillTesting"
              >
                Testing
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.testing.map((s) => (
                    <span class="bg-emerald-50 text-emerald-800 px-2.5 py-0.5 rounded-full text-xs border border-emerald-200 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- DevOps y Tooling -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillDevops"
              >
                DevOps y Tooling
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.devops.map((s) => (
                    <span class="bg-slate-100 text-slate-700 px-2.5 py-0.5 rounded-full text-xs border border-slate-300 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- Auth e Integración -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillAuth"
              >
                Auth e Integración
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.auth.map((s) => (
                    <span class="bg-orange-50 text-orange-800 px-2.5 py-0.5 rounded-full text-xs border border-orange-200 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- Bases de Datos -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillDatabases"
              >
                Bases de Datos
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.databases.map((s) => (
                    <span class="bg-amber-50 text-amber-800 px-2.5 py-0.5 rounded-full text-xs border border-amber-200 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- AI-Augmented Development -->
            <div class="print-avoid-break sm:col-span-2 lg:col-span-3">
              <h4
                class="font-semibold text-blue-700 mb-2 text-sm print:text-xs"
                data-i18n="skillAI"
              >
                AI-Augmented Development
              </h4>
              <div class="flex flex-wrap gap-1.5 print:gap-1">
                {
                  skillCategories.ai.map((s) => (
                    <span class="bg-violet-50 text-violet-800 px-2.5 py-0.5 rounded-full text-xs border border-violet-200 print:px-1.5 print:py-0">
                      {s}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <!-- Proyectos Destacados -->
        <section class="mb-8 print:mb-4">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
            data-i18n="featuredProjects"
          >
            Proyectos Destacados
          </h3>
          <div class="space-y-4 print:space-y-2">
            {
              projects.slice(0, 3).map((project, projIdx) => (
                <div class="print-avoid-break">
                  <div class="flex justify-between items-baseline mb-1">
                    <h4
                      class="font-bold text-blue-700 print:text-sm"
                      data-es={project.title}
                      data-en={
                        cvTranslationsEn.projects[projIdx]?.title ??
                        project.title
                      }
                    >
                      {project.title}
                    </h4>
                    {project.year && (
                      <span class="text-sm text-gray-600 print:text-xs">
                        {project.year}
                      </span>
                    )}
                  </div>
                  <p
                    class="text-sm text-justify leading-relaxed mb-2 print:text-xs print:mb-1"
                    set:html={processMarkdown(project.description)}
                    data-es={processMarkdown(project.description)}
                    data-en={processMarkdown(
                      cvTranslationsEn.projects[projIdx]?.description ??
                        project.description,
                    )}
                  />
                  <div>
                    <span
                      class="text-xs font-semibold text-gray-700 mr-2"
                      data-i18n="techStack"
                    >
                      Stack técnico:
                    </span>
                    <div class="inline-flex flex-wrap gap-1">
                      {project.technologies.map((tech) => (
                        <span class="bg-slate-50 text-slate-700 px-2 py-1 rounded text-xs border border-slate-200 print:px-1 print:py-0">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Educación y Desarrollo -->
        <section class="print-avoid-break">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
            data-i18n="educationAndDevelopment"
          >
            Educación y Desarrollo Profesional
          </h3>
          <div class="space-y-4 print:space-y-2">
            {
              education.map((edu, eduIdx) => (
                <div class="print-avoid-break">
                  <div class="flex justify-between items-baseline mb-1">
                    <h4
                      class="font-bold text-blue-700 print:text-sm"
                      data-es={edu.title}
                      data-en={
                        cvTranslationsEn.education[eduIdx]?.title ?? edu.title
                      }
                    >
                      {edu.title}
                    </h4>
                    <span class="text-sm text-gray-600 font-medium print:text-xs">
                      {edu.period}
                    </span>
                  </div>
                  {edu.institution && (
                    <p
                      set:html={processMarkdown(edu.institution)}
                      class="text-sm text-gray-600 font-medium mb-2 print:text-xs print:mb-1"
                    />
                  )}
                  <p
                    class="text-sm text-justify leading-relaxed mb-2 print:text-xs print:mb-1"
                    set:html={processMarkdown(edu.description)}
                    data-es={processMarkdown(edu.description)}
                    data-en={processMarkdown(
                      cvTranslationsEn.education[eduIdx]?.description ??
                        edu.description,
                    )}
                  />
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Script para mejorar la impresión -->
  <script>
    const triggerPrint = () => {
      if (window !== window.top) {
        // La página está en un iframe (ej. Simple Browser de VS Code),
        // abrir en nueva pestaña para poder imprimir
        window.open(window.location.href, "_blank");
      } else {
        window.print();
      }
    };

    // Botón de impresión manual
    const printBtn = document.getElementById("print-btn");
    if (printBtn) {
      printBtn.addEventListener("click", triggerPrint);
    }

    // Optimizar para impresión
    window.addEventListener("beforeprint", () => {
      document.body.classList.add("print-mode");
      // Agregar márgenes tipo Google Docs
      const style = document.createElement("style");
      style.id = "print-styles";
      style.textContent = `
        @page {
          margin: 1.27cm 1.27cm 1.27cm 1.27cm;
          size: A4;
        }
      `;
      document.head.appendChild(style);
    });

    window.addEventListener("afterprint", () => {
      document.body.classList.remove("print-mode");
      // Limpiar estilos de impresión
      const printStyles = document.getElementById("print-styles");
      if (printStyles) {
        printStyles.remove();
      }
    });

    // Atajo de teclado para imprimir
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "p") {
        e.preventDefault();
        triggerPrint();
      }
    });

    // Prevenir scroll involuntario durante la carga
    window.addEventListener("load", () => {
      window.scrollTo(0, 0);

      // Auto-imprimir si viene con ?print=true
      const params = new URLSearchParams(window.location.search);
      if (params.get("print") === "true") {
        window.print();
      }
    });
  </script>

  <script>
    import BackButton from "@/ui/components/BackButton.astro";

    document.addEventListener("DOMContentLoaded", () => {
      const I18N: Record<string, Record<string, string>> = {
        es: {
          backButton: "Volver",
          printCV: "Imprimir CV",
          technicalSkills: "Habilidades Técnicas",
          skillLanguages: "Lenguajes",
          skillFrameworks: "Frameworks y Bibliotecas",
          skillTesting: "Testing",
          skillDevops: "DevOps y Tooling",
          skillAuth: "Auth e Integración",
          skillDatabases: "Bases de Datos",
          skillAI: "AI-Augmented Development",
          professionalCompetencies: "Competencias Profesionales",
          featuredProjects: "Proyectos Destacados",
          educationAndDevelopment: "Educación y Desarrollo Profesional",
          keyAchievements: "Logros destacados:",
          techStack: "Stack técnico:",
        },
        en: {
          backButton: "Back",
          printCV: "Print CV",
          technicalSkills: "Technical Skills",
          skillLanguages: "Languages",
          skillFrameworks: "Frameworks & Libraries",
          skillTesting: "Testing",
          skillDevops: "DevOps & Tooling",
          skillAuth: "Auth & Integration",
          skillDatabases: "Databases",
          skillAI: "AI-Augmented Development",
          professionalCompetencies: "Professional Competencies",
          featuredProjects: "Featured Projects",
          educationAndDevelopment: "Education and Professional Development",
          keyAchievements: "Key achievements:",
          techStack: "Tech stack:",
        },
      };

      const langToggle = document.getElementById("lang-toggle");
      const langLabel = document.getElementById("lang-label");

      const applyLanguage = (lang: string) => {
        // Intercambiar etiquetas estáticas
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (key && I18N[lang]?.[key]) {
            el.textContent = I18N[lang][key];
          }
        });

        // Intercambiar contenido dinámico (innerHTML)
        document.querySelectorAll("[data-en]").forEach((el) => {
          const content = el.getAttribute(`data-${lang}`);
          if (content !== null) {
            el.innerHTML = content;
          }
        });

        // Actualizar etiqueta del botón
        if (langLabel) {
          langLabel.textContent = lang === "es" ? "EN" : "ES";
        }

        localStorage.setItem("cv-language", lang);
      };

      langToggle?.addEventListener("click", () => {
        const current = localStorage.getItem("cv-language") ?? "en";
        applyLanguage(current === "es" ? "en" : "es");
      });

      // Aplicar idioma guardado al cargar
      const saved = localStorage.getItem("cv-language") ?? "en";
      applyLanguage(saved);
    });
  </script>
</Layout>
