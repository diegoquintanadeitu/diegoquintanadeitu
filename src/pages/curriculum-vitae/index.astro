---
import { api } from "@/services/api";
import Layout from "@/ui/layouts/Layout.astro";
import BackButton from "@/ui/components/BackButton.astro";

// Obtener datos
const profile = await api.getProfile();
const timeline = await api.getTimeline();
const projects = await api.getProjects();
const skillCategories = await api.getSkills();
const education = await api.getEducation();

// Helper para procesar markdown simple
const processMarkdown = (text: string) => {
  return text
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
    .replace(/\*(.*?)\*/g, "<em>$1</em>");
};
---

<script is:inline>
  localStorage.setItem("portfolio-theme", "light");
</script>

<Layout
  title={`Curriculum Vitae - ${profile.name}`}
  showFooter={false}
  showThemeSelector={false}
>
  <style>
    @media print {
      body {
        margin: 0 !important;
        padding: 0 !important;
        font-size: 11px !important;
        line-height: 1.15 !important;
      }
      .print-break {
        page-break-before: always;
      }
      .print-avoid-break {
        page-break-inside: avoid;
      }
    }
  </style>

  <div class="bg-[#f5f5f5] min-h-screen pb-8 max-md:px-2">
    <!-- Navegación y acciones -->
    <div
      class="print:hidden sticky top-0 left-0 right-0 z-40 bg-[rgba(245,245,245,0.95)] backdrop-blur-[10px] border-b border-gray-300 p-4 mb-8 max-md:p-3 max-md:mb-4"
    >
      <div class="flex flex-col sm:flex-row gap-3 max-w-6xl mx-auto">
        <BackButton variant="secondary" />

        <button
          id="print-btn"
          class="bg-violet-800 hover:bg-violet-600 text-white px-6 py-3 rounded-lg font-medium flex items-center gap-2 justify-center sm:justify-start cursor-pointer btn-scale-animation"
          title="Imprimir Curriculum Vitae"
        >
          <svg
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
            ></path>
          </svg>
          Imprimir CV
        </button>
      </div>
    </div>

    <div
      class="max-w-[21cm] min-h-[29.7cm] mx-auto p-4 shadow-[0_4px_20px_rgba(0,0,0,0.15)] bg-white rounded-[4px] print:shadow-none print:mx-[1.27cm] print:max-w-none print:bg-white print:rounded-none max-md:mx-0 max-md:shadow-[0_2px_8px_rgba(0,0,0,0.1)] max-md:rounded-none"
    >
      <div>
        <header
          class="text-left border-b-2 border-blue-600 pb-2 mb-6 print-avoid-break"
        >
          <h1 class="text-3xl font-bold text-blue-800 mb-2 print:text-2xl">
            {profile.name}
          </h1>
          <h2 class="text-xl text-gray-600 mb-2 print:text-base">
            {profile.role}
          </h2>
          <div
            class="flex flex-col my-2 gap-2 justify-left text-sm text-gray-700 print:text-xs"
          >
            <div class="flex flex-row items-center">
              <span class="mr-1">📫 </span>
              diegoquintanadeitu@gmail.com
            </div>
            <div class="flex flex-row items-center">
              <span class="mr-1">🐙 </span>
              github.com/diegoquintanadeitu
            </div>
            <div class="flex flex-row items-center">
              <span class="mr-1">👨🏻‍💻 </span>
              linkedin.com/in/diego-daniel-martin-quintana
            </div>
            <div class="flex flex-row items-center">
              <span class="mr-1">🔗 </span>
              diegoquintanadeitu.github.io
            </div>
          </div>
        </header>

        <!-- Perfil Profesional -->
        <section
          class="mb-6 pb-6 border-b-2 border-blue-600 print-avoid-break print:mb-4"
        >
          <div
            class="space-y-3 text-sm text-justify leading-relaxed print:space-y-2 print:text-xs"
          >
            {
              profile.bio.map((paragraph) => (
                <p set:html={processMarkdown(paragraph)} />
              ))
            }
          </div>
        </section>

        <!-- Experiencia Profesional -->
        <section class="mb-8 print:mb-4">
          <div class="space-y-5">
            {
              timeline.map((job) => (
                <div class="print-avoid-break">
                  <div class="flex justify-between items-baseline mb-1">
                    <h4 class="font-bold text-blue-700 print:text-sm">
                      {job.title}
                    </h4>
                    <span class="text-sm text-gray-600 font-medium print:text-xs">
                      {job.period}
                    </span>
                  </div>
                  {job.company && (
                    <p class="text-sm text-gray-600 font-medium mb-2 print:text-xs print:mb-1">
                      {job.company}
                    </p>
                  )}
                  <p
                    class="text-sm text-justify leading-relaxed mb-2 print:text-xs print:mb-1"
                    set:html={processMarkdown(job.description)}
                  />
                  {job.technologies && job.technologies.length > 0 && (
                    <div class="mb-2 print:mb-1">
                      <span class="text-xs font-semibold text-gray-700 mr-2 print:text-xs">
                        Tecnologías:
                      </span>
                      <div class="inline-flex flex-wrap gap-1">
                        {job.technologies.map((tech) => (
                          <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-xs border print:px-1 print:py-0 print:text-xs">
                            {tech}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                  {job.achievements && (
                    <div class="text-xs text-gray-600 bg-blue-50 p-2 rounded border-l-2 border-blue-300 print:p-1 print:text-xs">
                      <span class="font-semibold block mb-1">
                        Logros destacados:
                      </span>
                      {job.achievements.map((achievement) => (
                        <span
                          class="block"
                          set:html={`- ${processMarkdown(achievement)}`}
                        />
                      ))}
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </section>

        <!-- Habilidades Técnicas -->
        <section class="mb-8 print-avoid-break print:mb-4">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
          >
            Habilidades Técnicas
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 print:gap-3">
            <!-- Herramientas -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-3 print:text-sm print:mb-2"
              >
                Herramientas y Plataformas
              </h4>
              <div class="flex flex-wrap gap-2 print:gap-1">
                {
                  skillCategories.tools
                    .slice(0, 8)
                    .map((tool) => (
                      <span class="bg-slate-50 text-slate-700 px-3 py-1 rounded-full text-xs border border-slate-200 print:px-2 print:py-0">
                        {tool}
                      </span>
                    ))
                }
              </div>
            </div>
            <!-- Tecnologías Principales -->
            <div class="print-avoid-break">
              <h4
                class="font-semibold text-blue-700 mb-3 print:text-sm print:mb-2"
              >
                Lenguajes y Frameworks
              </h4>
              <div class="flex flex-wrap gap-2 print:gap-1">
                {
                  skillCategories.technical
                    .slice(0, 12)
                    .map((skill) => (
                      <span class="bg-blue-50 text-blue-800 px-3 py-1 rounded-full text-xs border border-blue-200 print:px-2 print:py-0">
                        {skill}
                      </span>
                    ))
                }
              </div>
            </div>
          </div>
        </section>

        <!-- Habilidades Interpersonales -->
        <section class="mb-8 print-avoid-break print:mb-4">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
          >
            Competencias Profesionales
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 print:gap-2">
            {
              Object.entries(skillCategories.soft)
                .slice(0, 6)
                .map(([skillName, description]) => (
                  <div class="print-avoid-break">
                    <h4 class="font-semibold text-orange-700 text-sm mb-1 print:text-xs">
                      {skillName}
                    </h4>
                    <p class="text-xs text-gray-600 leading-relaxed print:text-xs">
                      {description}
                    </p>
                  </div>
                ))
            }
          </div>
        </section>

        <!-- Proyectos Destacados -->
        <section class="mb-8 print:mb-4">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
          >
            Proyectos Destacados
          </h3>
          <div class="space-y-4 print:space-y-2">
            {
              projects.slice(0, 3).map((project) => (
                <div class="print-avoid-break">
                  <div class="flex justify-between items-baseline mb-1">
                    <h4 class="font-bold text-blue-700 print:text-sm">
                      {project.title}
                    </h4>
                    {project.year && (
                      <span class="text-sm text-gray-600 print:text-xs">
                        {project.year}
                      </span>
                    )}
                  </div>
                  <p
                    class="text-sm text-justify leading-relaxed mb-2 print:text-xs print:mb-1"
                    set:html={processMarkdown(project.description)}
                  />
                  <div>
                    <span class="text-xs font-semibold text-gray-700 mr-2">
                      Stack técnico:
                    </span>
                    <div class="inline-flex flex-wrap gap-1">
                      {project.technologies.map((tech) => (
                        <span class="bg-slate-50 text-slate-700 px-2 py-1 rounded text-xs border border-slate-200 print:px-1 print:py-0">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Educación y Desarrollo -->
        <section class="print-avoid-break">
          <h3
            class="text-lg font-bold text-blue-800 border-b border-gray-300 pb-1 mb-4 uppercase tracking-wide print:text-base print:mb-2"
          >
            Educación y Desarrollo Profesional
          </h3>
          <div class="space-y-4 print:space-y-2">
            {
              education.map((edu) => (
                <div class="print-avoid-break">
                  <div class="flex justify-between items-baseline mb-1">
                    <h4 class="font-bold text-blue-700 print:text-sm">
                      {edu.title}
                    </h4>
                    <span class="text-sm text-gray-600 font-medium print:text-xs">
                      {edu.period}
                    </span>
                  </div>
                  {edu.institution && (
                    <p
                      set:html={processMarkdown(edu.institution)}
                      class="text-sm text-gray-600 font-medium mb-2 print:text-xs print:mb-1"
                    />
                  )}
                  <p
                    class="text-sm text-justify leading-relaxed mb-2 print:text-xs print:mb-1"
                    set:html={processMarkdown(edu.description)}
                  />
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Script para mejorar la impresión -->
  <script>
    // Botón de impresión manual
    const printBtn = document.getElementById("print-btn");
    if (printBtn) {
      printBtn.addEventListener("click", () => {
        window.print();
      });
    }

    // Optimizar para impresión
    window.addEventListener("beforeprint", () => {
      document.body.classList.add("print-mode");
      // Agregar márgenes tipo Google Docs
      const style = document.createElement("style");
      style.id = "print-styles";
      style.textContent = `
        @page {
          margin: 1.27cm 1.27cm 1.27cm 1.27cm;
          size: A4;
        }
      `;
      document.head.appendChild(style);
    });

    window.addEventListener("afterprint", () => {
      document.body.classList.remove("print-mode");
      // Limpiar estilos de impresión
      const printStyles = document.getElementById("print-styles");
      if (printStyles) {
        printStyles.remove();
      }
    });

    // Atajo de teclado para imprimir
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "p") {
        e.preventDefault();
        window.print();
      }
    });

    // Prevenir scroll involuntario durante la carga
    window.addEventListener("load", () => {
      window.scrollTo(0, 0);
    });
  </script>
</Layout>
