---
import {api} from '@/services/api';
import Layout from '@/ui/layouts/Layout.astro';
import HoverCard from '@/ui/components/HoverCard.astro';
import TechStack from '@/ui/components/TechStack.astro';

// Obtener datos
const profile = await api.getProfile();
const timeline = await api.getTimeline();
const projects = await api.getProjects();
const bioSplitIndex = Math.ceil(profile.bio.length / 2);
const bioRight = profile.bio.slice(bioSplitIndex);

// Helper para procesar markdown simple
const processMarkdown = (text: string) => {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
};
---

<script is:inline>
  localStorage.setItem("portfolio-theme", "dark");
</script>

<Layout
  title={profile.name}
  description={`Portfolio de ${profile.name}, ${profile.role}. 8 años de experiencia en TypeScript, React y Next.js en startups y fintechs como Ualá. Disponible para proyectos remotos en LATAM.`}
>

  <main
    class='flex flex-col justify-center min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50'
  > 
    <section class='relative mx-auto max-w-7xl'>
      <div class='w-full h-full p-8 md:pt-12'>
        <div class='flex flex-col-reverse md:flex-row md:items-start md:justify-between gap-8'>

          <!-- Columna izquierda: contenido de texto -->
          <div class='flex-1 text-left'>
            <h1
              class='text-3xl text-wrap md:text-4xl font-extrabold bg-gradient-to-r from-blue-600 via-purple-600 to-blue-800 bg-clip-text text-transparent leading-tight pb-1 mb-2'
            >
              {profile.name}
            </h1>

            <h3 class='text-md md:text-2xl text-slate-600 mb-4 md:mb-6 font-medium'>{profile.role}</p>

            <TechStack stack={profile.techStack} />

            {profile.bio.map((paragraph, index) => (
              <p
                class={`text-md md:text-lg text-slate-600 leading-relaxed ${index >= bioSplitIndex ? 'md:hidden' : ''}`}
                set:html={processMarkdown(paragraph)}
              />
            ))}
            <div class='hidden lg:block mt-6 space-y-4'>
              {bioRight.map((paragraph) => (
                <p
                  class='text-md md:text-lg text-slate-600 leading-relaxed'
                  set:html={processMarkdown(paragraph)}
                />
              ))}
            </div>

            <div class='flex flex-wrap justify-center md:justify-start gap-4 mt-8'>
          <!-- CV Button - Prioritario para recruiters -->
          <div class='relative w-full sm:w-auto' id='cv-dropdown-wrapper'>
            <button
              id='cv-dropdown-btn'
              type='button'
              class='w-full sm:w-auto inline-flex justify-center items-center h-14 px-8 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 !text-white rounded-xl font-bold text-lg shadow-xl hover:shadow-2xl btn-scale-animation gap-3'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                  d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                />
              </svg>
              Curriculum Vitae
              <svg class='w-4 h-4 transition-transform duration-200' id='cv-chevron' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7' />
              </svg>
            </button>

            <!-- Dropdown menu -->
            <div
              id='cv-dropdown-menu'
              class='hidden absolute left-0 sm:left-auto sm:right-0 top-full mt-2 w-full sm:w-52 bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden z-50'
            >
              <a
                href='/curriculum-vitae'
                target='_blank'
                class='flex items-center gap-3 px-5 py-4 text-slate-700 dark:text-slate-200 hover:bg-indigo-50 dark:hover:bg-slate-700 text-sm transition-colors'
              >
                <svg class='w-5 h-5 text-indigo-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 12a3 3 0 11-6 0 3 3 0 016 0z' />
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z' />
                </svg>
                Ver CV
              </a>
              <div class='border-t border-slate-100 dark:border-slate-700'></div>
              <a
                href='/curriculum-vitae?print=true'
                target='_blank'
                class='flex items-center gap-3 px-5 py-4 text-slate-700 dark:text-slate-200 hover:bg-indigo-50 dark:hover:bg-slate-700 text-sm transition-colors'
              >
                <svg class='w-5 h-5 text-purple-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                    d='M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4'
                  />
                </svg>
                Descargar PDF
              </a>
            </div>
          </div>

          <script>
            const wrapper = document.getElementById('cv-dropdown-wrapper');
            const btn = document.getElementById('cv-dropdown-btn');
            const menu = document.getElementById('cv-dropdown-menu');
            const chevron = document.getElementById('cv-chevron');

            btn?.addEventListener('click', (e) => {
              e.stopPropagation();
              const isOpen = !menu?.classList.contains('hidden');
              menu?.classList.toggle('hidden', isOpen);
              chevron?.classList.toggle('rotate-180', !isOpen);
            });

            document.addEventListener('click', () => {
              menu?.classList.add('hidden');
              chevron?.classList.remove('rotate-180');
            });
          </script>

          <!-- <a
            href='/roadmap'
            class='w-full sm:w-auto inline-flex justify-center items-center h-14 px-8 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-xl font-bold text-lg shadow-xl hover:shadow-2xl btn-scale-animation'
          >
            <svg
              class='w-6 h-6 mr-3'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7'
              ></path>
            </svg>
            Roadmap 2026
          </a> -->

          <!-- Botón para ir a la página de juegos -->
          <a
            id='game-button' style='display: none;'
            href="/play"
            class='w-full sm:w-auto inline-flex justify-center items-center h-14 px-8 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 !text-white rounded-xl font-bold text-lg shadow-xl hover:shadow-2xl btn-scale-animation'
          >
            <svg
              class='w-6 h-6 mr-3'
              xmlns='http://www.w3.org/2000/svg'
              fill='currentColor'
              viewBox='0 0 24 24'
            >
              <path d='M6.5 3C5.67 3 5 3.67 5 4.5S5.67 6 6.5 6 8 5.33 8 4.5 7.33 3 6.5 3zM17.5 3c-.83 0-1.5.67-1.5 1.5S16.67 6 17.5 6 19 5.33 19 4.5 18.33 3 17.5 3zM12 7c-2.21 0-4 1.79-4 4v1H7v2h1v1c0 2.21 1.79 4 4 4s4-1.79 4-4v-1h1v-2h-1v-1c0-2.21-1.79-4-4-4zm-2 5h4v1h-4v-1z'/>
            </svg>
            Play
          </a>
            </div>

            
          </div>

          <!-- Columna derecha: foto de perfil -->
          <div class='flex flex-col justify-start shrink-0 items-center md:align-top md:w-[22rem]'>
            <HoverCard class='w-full max-w-sm rounded-full border-0' contentClass='p-2'>
              <div class='relative aspect-[1/1] w-full rounded-full overflow-hidden'>
                <!-- Placeholder difuminado -->
                <div
                  id='profile-placeholder'
                  class='absolute inset-0 rounded-full bg-gradient-to-br from-blue-600 via-blue-400 to-blue-200 animate-pulse'
                ></div>
                <img
                  id='profile-img'
                  src='/profile.webp'
                  alt='Foto de perfil de Diego Quintana'
                  class='relative w-full h-full rounded-full object-cover object-top transition-all duration-700 group-hover:scale-[1.02] opacity-0 blur-md scale-105'
                />
              </div>
            </HoverCard>

            <div class='hidden md:block lg:hidden mt-6 space-y-4'>
              {bioRight.map((paragraph) => (
                <p
                  class='text-md md:text-lg text-slate-600 leading-relaxed'
                  set:html={processMarkdown(paragraph)}
                />
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>
  
    <section class='relative mx-auto max-w-7xl pr-4 md:pr-0'>
      <div class='container mx-auto'>

        <div class='relative'>
          <!-- Línea central del timeline (desktop) -->
          <div
            class='hidden md:block absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-gradient-to-b from-blue-500 to-purple-500 rounded-full z-10'
          >
          </div>
          
          <!-- Línea izquierda del timeline (mobile) -->
          <div
            class='md:hidden absolute left-4 w-1 h-full bg-gradient-to-b from-blue-500 to-purple-500 rounded-full z-10'
          >
          </div>

          {
            timeline.map((item, index) => (
              <div
                class={`relative mb-16 ${index % 2 === 0 ? 'md:text-right md:pr-1/2' : 'md:text-left md:pl-1/2'}`}
              >
                <!-- Contenedor de la card con más separación -->
                <div class={`w-full md:w-5/12 ${index % 2 === 0 ? 'md:ml-auto md:mr-8' : 'md:ml-8'} pl-12 md:pl-0`}>
                  <!-- Fecha con estilo moderno -->
                  <div class={`mb-1 ${index % 2 === 0 ? 'md:text-left md:ml-0' : 'md:text-right md:mr-0'} text-left`}>
                    <span class='relative inline-block text-sm font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600 after:content-[""] after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-gradient-to-r after:from-blue-600 after:to-purple-600 after:transform after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300'>
                      {item.period}
                    </span>
                  </div>
                  
                  <!-- Card del contenido -->
                  <HoverCard class='rounded-2xl border border-slate-100' contentClass='p-6'>
                    <h3 class='text-xl font-bold text-slate-800 mb-1'>
                      {item.title}
                    </h3>
                    {item.company && (
                      <p class='text-blue-600 font-medium text-sm mb-3'>
                        {item.company}
                      </p>
                    )}
                    <p 
                      class='text-slate-600 mb-4'
                      set:html={processMarkdown(item.description)}
                    ></p>
                    {item.technologies && (
                      <div class='flex flex-wrap gap-2'>
                        {item.technologies.map((tech) => (
                          <span class='px-2 py-1 bg-slate-100 text-slate-600 rounded text-xs'>
                            {tech}
                          </span>
                        ))}
                      </div>
                    )}
                  </HoverCard>
                </div>
              </div>
            ))
          }
        </div>
      </div>



    </section>

    <section class='py-16 px-4 bg-gradient-to-br from-slate-50 to-blue-50' style="display: none;">
      <div class='container mx-auto'>
        <h2 class='text-4xl font-bold text-center mb-16 text-slate-800'>
          Proyectos
          <div
            class='w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mt-4 rounded-full'
          >
          </div>
        </h2>

        <div class='grid gap-8 md:grid-cols-2 lg:grid-cols-3'>
          {
            projects.map((project) => (
              <HoverCard class='rounded-2xl border border-slate-100' contentClass='p-6'>
                  <h3 class='text-xl font-bold text-slate-800 mb-3 group-hover:text-blue-600 transition-colors'>
                    {project.title}
                  </h3>
                  <p class='text-slate-600 mb-4 leading-relaxed'>
                    {project.description}
                  </p>

                  <div class='flex flex-wrap gap-2 mb-4'>
                    {project.technologies.map((tech) => (
                      <span class='px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-sm hover:bg-blue-50 hover:text-blue-600 transition-colors'>
                        {tech}
                      </span>
                    ))}
                  </div>

                  {project.link && (
                    <a
                      href={project.link}
                      class='inline-flex items-center text-blue-600 hover:text-blue-800 font-medium transition-colors'
                      target='_blank'
                      rel='noopener noreferrer'
                    >
                      Ver proyecto
                      <svg
                        class='w-4 h-4 ml-1'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14'
                        />
                      </svg>
                    </a>
                  )}
              </HoverCard>
            ))
          }
        </div>
        
      </div>
    </section>

    
    <section class='py-16 px-4 bg-slate-800' style="display: none;">
      <div class='container mx-auto text-center'>
        

        <div class='flex flex-wrap justify-center gap-4'>
          <a
            href='mailto:diegoquintanadeitu@gmail.com'
            class='flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium btn-scale-animation'
          >
            <svg
              class='w-5 h-5 mr-2'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M3 8l7.89 4.76a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
