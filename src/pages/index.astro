---
import {api} from '@/services/api';
import Layout from '@/ui/layouts/Layout.astro';

// Obtener datos
const profile = await api.getProfile();
const timeline = await api.getTimeline();
const projects = await api.getProjects();
const skillCategories = await api.getSkills();
const techEvolution = await api.getTechEvolution();
---

<Layout title={profile.name}>

  <main
    class='flex flex-col justify-center min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50'
  > 
    <section class='relative mx-auto max-w-7xl'>
      <div class='w-full h-full p-8 md:pt-12 text-left'>
        <div class='relative inline-block'>
          <h1
            class='text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-blue-600 via-purple-600 to-blue-800 bg-clip-text text-transparent leading-tight pb-1'
          >
            {profile.name}
          </h1>
        </div>

        <p class='text-md md:text-2xl text-slate-600 mb-4 md:mb-6 font-medium'>{profile.role}</p>

        <div class='bg-white rounded-2xl shadow-lg p-6 border border-slate-100 hover:shadow-xl transition-all duration-300 relative text-left space-y-4 mb-6 md:mb-8'>
          {
            profile.bio.map((paragraph) => (
              <p class='text-md md:text-lg text-slate-600 leading-relaxed'>{paragraph}</p>
            ))
          }
        </div>

        <div class='flex flex-wrap md:justify-start justify-center gap-4'>
          <!-- CV Button - Prioritario para recruiters -->
          <a
            href="/curriculum-vitae"
            class='w-full md:w-auto inline-flex justify-center items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white rounded-xl font-bold text-lg shadow-xl hover:shadow-2xl btn-scale-animation'
          >
            <svg
              class='w-6 h-6 mr-3'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
              ></path>
            </svg>
            Curriculum Vitae
          </a>

          <!-- Botón para ir a la página de juegos -->
          <a
            id='game-button' style='display: none;'
            href="/play"
            class='w-full md:w-auto inline-flex justify-center items-center px-8 py-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white rounded-xl font-bold text-lg shadow-xl hover:shadow-2xl btn-scale-animation'
          >
            <svg
              class='w-6 h-6 mr-3'
              xmlns='http://www.w3.org/2000/svg'
              fill='currentColor'
              viewBox='0 0 24 24'
            >
              <path d='M6.5 3C5.67 3 5 3.67 5 4.5S5.67 6 6.5 6 8 5.33 8 4.5 7.33 3 6.5 3zM17.5 3c-.83 0-1.5.67-1.5 1.5S16.67 6 17.5 6 19 5.33 19 4.5 18.33 3 17.5 3zM12 7c-2.21 0-4 1.79-4 4v1H7v2h1v1c0 2.21 1.79 4 4 4s4-1.79 4-4v-1h1v-2h-1v-1c0-2.21-1.79-4-4-4zm-2 5h4v1h-4v-1z'/>
            </svg>
            Play
          </a>
        </div>
      </div>
    </section>
  
    <section class='relative mx-auto max-w-7xl pr-4 md:pr-0'>
      <div class='container mx-auto'>

        <div class='relative'>
          <!-- Línea central del timeline (desktop) -->
          <div
            class='hidden md:block absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-gradient-to-b from-blue-500 to-purple-500 rounded-full z-10'
          >
          </div>
          
          <!-- Línea izquierda del timeline (mobile) -->
          <div
            class='md:hidden absolute left-4 w-1 h-full bg-gradient-to-b from-blue-500 to-purple-500 rounded-full z-10'
          >
          </div>

          {
            timeline.map((item, index) => (
              <div
                class={`relative mb-16 ${index % 2 === 0 ? 'md:text-right md:pr-1/2' : 'md:text-left md:pl-1/2'}`}
              >
                <!-- Contenedor de la card con más separación -->
                <div class={`w-full md:w-5/12 ${index % 2 === 0 ? 'md:ml-auto md:mr-8' : 'md:ml-8'} pl-12 md:pl-0`}>
                  <!-- Fecha con estilo moderno -->
                  <div class={`mb-1 ${index % 2 === 0 ? 'md:text-left md:ml-0' : 'md:text-right md:mr-0'} text-left`}>
                    <span class='relative inline-block text-sm font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600 after:content-[""] after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-gradient-to-r after:from-blue-600 after:to-purple-600 after:transform after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300'>
                      {item.period}
                    </span>
                  </div>
                  
                  <!-- Card del contenido -->
                  <div class='bg-white rounded-2xl shadow-lg p-6 border border-slate-100 hover:shadow-xl transition-all duration-300 relative'>
                    <h3 class='text-xl font-bold text-slate-800 mb-1'>
                      {item.title}
                    </h3>
                    {item.company && (
                      <p class='text-blue-600 font-medium text-sm mb-3'>
                        {item.company}
                      </p>
                    )}
                    <p class='text-slate-600 mb-4'>{item.description}</p>
                    {item.technologies && (
                      <div class='flex flex-wrap gap-2'>
                        {item.technologies.map((tech) => (
                          <span class='px-2 py-1 bg-slate-100 text-slate-600 rounded text-xs'>
                            {tech}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>



    </section>

    <section class='py-16 px-4 bg-gradient-to-br from-slate-50 to-blue-50' style="display: none;">
      <div class='container mx-auto'>
        <h2 class='text-4xl font-bold text-center mb-16 text-slate-800'>
          Proyectos
          <div
            class='w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mt-4 rounded-full'
          >
          </div>
        </h2>

        <div class='grid gap-8 md:grid-cols-2 lg:grid-cols-3'>
          {
            projects.map((project) => (
              <div class='bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100 group'>
                <div class='p-6'>
                  <h3 class='text-xl font-bold text-slate-800 mb-3 group-hover:text-blue-600 transition-colors'>
                    {project.title}
                  </h3>
                  <p class='text-slate-600 mb-4 leading-relaxed'>
                    {project.description}
                  </p>

                  <div class='flex flex-wrap gap-2 mb-4'>
                    {project.technologies.map((tech) => (
                      <span class='px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-sm hover:bg-blue-50 hover:text-blue-600 transition-colors'>
                        {tech}
                      </span>
                    ))}
                  </div>

                  {project.link && (
                    <a
                      href={project.link}
                      class='inline-flex items-center text-blue-600 hover:text-blue-800 font-medium transition-colors'
                      target='_blank'
                      rel='noopener noreferrer'
                    >
                      Ver proyecto
                      <svg
                        class='w-4 h-4 ml-1'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14'
                        />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class='py-16 px-4 bg-slate-800' style="display: none;">
      <div class='container mx-auto text-center'>

        <div class='flex flex-wrap justify-center gap-4'>
          <a
            href='mailto:diegoquintanadeitu@gmail.com'
            class='flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium btn-scale-animation'
          >
            <svg
              class='w-5 h-5 mr-2'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M3 8l7.89 4.76a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
              ></path>
            </svg>
            Email
          </a>

          <a
            href='https://linkedin.com/in/diego-daniel-martin-quintana'
            class='flex items-center px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-lg font-medium btn-scale-animation'
            target='_blank'
            rel='noopener noreferrer'
          >
            <svg class='w-5 h-5 mr-2' fill='currentColor' viewBox='0 0 24 24'>
              <path
                d='M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'
              ></path>
            </svg>
            LinkedIn
          </a>

          <a
            href='https://github.com/diegoquintanadeitu'
            class='flex items-center px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-lg font-medium btn-scale-animation'
            target='_blank'
            rel='noopener noreferrer'
          >
            <svg class='w-5 h-5 mr-2' fill='currentColor' viewBox='0 0 24 24'>
              <path
                d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'
              ></path>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>


    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
        let konamiIndex = 0;

        document.addEventListener('keydown', (event) => {
          if (event.key === konamiCode[konamiIndex]) {
            konamiIndex++;
            if (konamiIndex === konamiCode.length) {
              const gameButton = document.getElementById('game-button');
              if (gameButton) {
                localStorage.setItem("play-access", "true"); // Agregar flag en localStorage
                gameButton.style.display = 'flex';
              }
              konamiIndex = 0; // Reset the sequence
            }
          } else {
            konamiIndex = 0; // Reset if the sequence is broken
          }
        });
      });

    document.addEventListener("keydown", function (event) {
      const keyDisplay = document.createElement("div");
      keyDisplay.textContent = event.key;
      keyDisplay.style.position = "fixed";
      keyDisplay.style.bottom = "10px";
      keyDisplay.style.right = "10px";
      keyDisplay.style.backgroundColor = "rgba(0, 0, 0, 0.7)";
      keyDisplay.style.color = "white";
      keyDisplay.style.padding = "5px 10px";
      keyDisplay.style.borderRadius = "5px";
      keyDisplay.style.zIndex = "1000";
      keyDisplay.style.transition = "transform 0.3s ease, opacity 0.3s ease";

      const existingKeys = document.querySelectorAll<HTMLElement>(".key-display");
      existingKeys.forEach((key, index) => {
          key.style.transform = `translateY(-${(index + 1) * 30}px)`;
      });

      keyDisplay.classList.add("key-display");
      document.body.appendChild(keyDisplay);

      setTimeout(() => {
        keyDisplay.style.opacity = "0";
        keyDisplay.addEventListener("transitionend", () => {
          keyDisplay.remove();
        });
      }, 1000);
    });
  </script>
</Layout>
