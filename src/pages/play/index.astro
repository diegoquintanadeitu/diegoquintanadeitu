---
import Layout from "@/ui/layouts/Layout.astro";
import BackButton from "@/ui/components/BackButton.astro";
---

<script>
  if (typeof window !== "undefined") {
    const isAuthorized = localStorage.getItem("play-access");

    if (isAuthorized !== "true") {
      document.body.innerHTML =
        "<div style='display: flex; justify-content: center; align-items: center; height: 100vh; font-size: 1.5rem;'>Redirigiendo...</div>";
      window.location.replace("/"); // Redirigir inmediatamente antes de renderizar
    } else {
      localStorage.removeItem("play-access"); // Eliminar el acceso después de la verificación
    }
  }
</script>

<Layout title="Play - Retro Arcade">
  <main
    class="flex flex-col min-h-screen bg-gradient-to-br from-slate-100 via-blue-100 to-indigo-200 dark:from-purple-900 dark:via-blue-900 dark:to-indigo-900 p-4 md:p-6"
  >
    <!-- Botón de regreso arriba -->
    <div class="w-full mb-4">
      <BackButton
        class="transform hover:scale-105 transition-all duration-200"
        variant="secondary"
      />
    </div>

    <!-- Título centrado -->
    <header class="w-full mb-6 md:mb-8 text-right">
      <h1
        class="text-4xl md:text-5xl font-bold text-gray-800 dark:text-white mb-2"
      >
        Retro Arcade
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Elegí tu juego favorito
      </p>
    </header>

    <!-- Contenedor del juego -->
    <div class="flex-1 mb-4 flex flex-col md:flex-row gap-4">
      <!-- Iframe: lado izquierdo -->
      <div class="relative flex-1">
        <div
          class="absolute inset-0 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-xl blur-xl"
        >
        </div>
        <iframe
          id="game-frame"
          src={"https://www.retrogames.cc"}
          class="relative w-full h-full min-h-[350px] md:min-h-[500px] border-2 border-gray-300 dark:border-white rounded-xl shadow-2xl backdrop-blur-sm bg-white dark:bg-black"
          allowfullscreen="true"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-presentation"
          referrerpolicy="no-referrer-when-downgrade"
          loading="lazy"
          title="Juego seleccionado"
        >
        </iframe>
      </div>

      <!-- Panel derecho: ilustración retro -->
      <div
        class="hidden md:flex md:w-64 lg:w-80 flex-col items-center justify-center gap-6 bg-white dark:bg-black backdrop-blur-sm rounded-xl border-2 border-gray-300 dark:border-white p-6"
      >
        <!-- Game Boy SVG -->
        <svg
          viewBox="0 0 160 240"
          xmlns="http://www.w3.org/2000/svg"
          class="w-40 drop-shadow-2xl"
        >
          <!-- Cuerpo -->
          <rect
            x="10"
            y="10"
            width="140"
            height="220"
            rx="20"
            ry="20"
            fill="#c8b4e8"></rect>
          <rect
            x="14"
            y="14"
            width="132"
            height="212"
            rx="17"
            ry="17"
            fill="#b89fd8"></rect>
          <!-- Pantalla exterior -->
          <rect x="25" y="25" width="110" height="90" rx="8" ry="8" fill="#444"
          ></rect>
          <!-- Pantalla interior (verde como Game Boy original) -->
          <rect
            x="30"
            y="30"
            width="100"
            height="80"
            rx="4"
            ry="4"
            fill="#8bac0f"></rect>
          <!-- Pixel art simple en pantalla: marciano -->
          <g fill="#0f380f">
            <rect x="55" y="45" width="8" height="8"></rect>
            <rect x="97" y="45" width="8" height="8"></rect>
            <rect x="63" y="53" width="8" height="8"></rect>
            <rect x="89" y="53" width="8" height="8"></rect>
            <rect x="55" y="61" width="50" height="8"></rect>
            <rect x="63" y="69" width="8" height="8"></rect>
            <rect x="89" y="69" width="8" height="8"></rect>
            <rect x="71" y="77" width="8" height="8"></rect>
            <rect x="55" y="69" width="8" height="8"></rect>
            <rect x="97" y="69" width="8" height="8"></rect>
          </g>
          <!-- D-pad -->
          <rect x="28" y="140" width="14" height="40" rx="3" fill="#2d2d2d"
          ></rect>
          <rect x="21" y="147" width="28" height="14" rx="3" fill="#2d2d2d"
          ></rect>
          <circle cx="35" cy="160" r="5" fill="#555"></circle>
          <!-- Botones A y B -->
          <circle cx="118" cy="155" r="10" fill="#e84040"></circle>
          <circle cx="100" cy="163" r="10" fill="#4040e8"></circle>
          <text
            x="116"
            y="159"
            font-size="10"
            fill="white"
            text-anchor="middle"
            font-family="monospace"
            font-weight="bold">A</text
          >
          <text
            x="98"
            y="167"
            font-size="10"
            fill="white"
            text-anchor="middle"
            font-family="monospace"
            font-weight="bold">B</text
          >
          <!-- Select / Start -->
          <rect x="52" y="185" width="22" height="7" rx="3" fill="#555"></rect>
          <rect x="86" y="185" width="22" height="7" rx="3" fill="#555"></rect>
          <text
            x="63"
            y="191"
            font-size="5"
            fill="#aaa"
            text-anchor="middle"
            font-family="monospace">SELECT</text
          >
          <text
            x="97"
            y="191"
            font-size="5"
            fill="#aaa"
            text-anchor="middle"
            font-family="monospace">START</text
          >
          <!-- Altavoz -->
          <g stroke="#9980c8" stroke-width="2" stroke-linecap="round">
            <line x1="105" y1="200" x2="105" y2="215"></line>
            <line x1="111" y1="198" x2="111" y2="217"></line>
            <line x1="117" y1="200" x2="117" y2="215"></line>
            <line x1="123" y1="202" x2="123" y2="213"></line>
            <line x1="129" y1="205" x2="129" y2="210"></line>
          </g>
        </svg>

        <div class="text-center">
          <p
            class="text-sm font-bold text-purple-300 tracking-widest uppercase mb-1"
          >
            Retro Arcade
          </p>
          <p class="text-xs text-gray-400">Insert coin to play</p>
        </div>

        <!-- Blink cursor -->
        <div class="flex gap-1 items-center">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
          <span
            class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse [animation-delay:0.3s]"
          ></span>
          <span
            class="w-2 h-2 rounded-full bg-pink-400 animate-pulse [animation-delay:0.6s]"
          ></span>
        </div>
      </div>
    </div>

    <!-- Info del sistema en el footer -->
    <footer class="w-full">
      <div class="flex justify-center">
        <div
          class="bg-white dark:bg-black backdrop-blur-sm rounded-lg px-4 py-2 border border-gray-300 dark:border-white"
        >
          <div
            id="user-info"
            class="text-xs text-gray-600 dark:text-gray-300 text-center"
          >
            <span id="secret-info" class="font-mono">Cargando...</span>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <style>
    /* Custom keyframe animation for gradient title */
    @keyframes gradient-shift {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }

    h1 {
      background-size: 200% 200%;
      animation: gradient-shift 3s ease-in-out infinite;
    }

    /* Background particle effect via pseudo-element */
    main::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(
          circle at 20% 20%,
          rgba(120, 119, 198, 0.3) 0%,
          transparent 50%
        ),
        radial-gradient(
          circle at 80% 80%,
          rgba(255, 119, 198, 0.3) 0%,
          transparent 50%
        ),
        radial-gradient(
          circle at 40% 40%,
          rgba(120, 219, 255, 0.3) 0%,
          transparent 50%
        );
      pointer-events: none;
      z-index: -1;
    }

    /* backdrop-filter for info panel */
    #user-info {
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  </style>
</Layout>

<script is:inline>
  let batteryInfo = "";
  let weatherInfo = "";
  let historyInfo = "";
  let lastBatteryUpdate = 0;
  let lastWeatherUpdate = 0;

  async function updateBatteryInfo() {
    if ("getBattery" in navigator) {
      try {
        const battery = await navigator.getBattery();
        const batteryLevel = Math.round(battery.level * 100);
        const charging = battery.charging ? "🔌" : "🔋";
        batteryInfo = `${charging} ${batteryLevel}%`;
      } catch (e) {
        batteryInfo = "🔋 N/A";
      }
    } else {
      batteryInfo = "🔋 N/A";
    }
  }

  async function updateWeatherInfo() {
    try {
      // Importar dinámicamente la utilidad de clima
      const { WeatherEstimator } = await import("../../utils/weather.ts");
      const weather = WeatherEstimator.estimateWeather();
      weatherInfo = WeatherEstimator.formatWeatherString(weather);
    } catch (e) {
      weatherInfo = "🌡️ Ubicación desconocida";
    }
  }

  function updateHistoryInfo() {
    try {
      const historyData = [
        `⏰ ${new Date().toLocaleTimeString()}`,
        `📅 ${new Date().toLocaleDateString()}`,
        `🖱️ Clicks: ${parseInt(localStorage.getItem("clickCount") || "0")}`,
      ];

      historyInfo =
        historyData[Math.floor(Date.now() / 4000) % historyData.length];
    } catch (e) {
      historyInfo = "📊 Info no disponible";
    }
  }

  function updateRotatingInfo() {
    const now = Date.now();

    // Actualizar batería cada 2 minutos (120000ms)
    if (now - lastBatteryUpdate > 120000) {
      updateBatteryInfo();
      lastBatteryUpdate = now;
    }

    // Actualizar clima cada 5 minutos (300000ms)
    if (now - lastWeatherUpdate > 300000) {
      updateWeatherInfo();
      lastWeatherUpdate = now;
    }

    // Actualizar historial cada vez
    updateHistoryInfo();

    // Rotar entre los datos cada 3 segundos
    const rotatingData = [batteryInfo, weatherInfo, historyInfo].filter(
      Boolean,
    );
    const currentIndex = Math.floor(Date.now() / 3000) % rotatingData.length;

    document.getElementById("secret-info").textContent =
      rotatingData[currentIndex] || "Cargando...";
  }

  // Contador de clicks
  document.addEventListener("click", () => {
    const clickCount = parseInt(localStorage.getItem("clickCount") || "0") + 1;
    localStorage.setItem("clickCount", clickCount.toString());
  });

  // Suprimir errores de CORS del iframe
  window.addEventListener("error", (e) => {
    if (e.message && e.message.includes("cross-origin")) {
      e.preventDefault();
      console.warn("CORS error suprimido del iframe externo");
      return false;
    }
  });

  // Suprimir advertencias específicas de TCF API
  const originalConsoleError = console.error;
  console.error = function (...args) {
    const message = args.join(" ");
    if (
      message.includes("TCF IFRAME") ||
      message.includes("__tcfapiLocator") ||
      message.includes("cross-origin frame")
    ) {
      return; // Suprimir estos errores específicos
    }
    originalConsoleError.apply(console, args);
  };

  document.addEventListener("DOMContentLoaded", () => {
    // Inicializar datos
    updateBatteryInfo();
    updateWeatherInfo();
    updateHistoryInfo();

    // Actualizar cada segundo para la rotación
    setInterval(updateRotatingInfo, 1000);

    // Configurar manejo seguro del iframe
    const iframe = document.getElementById("game-frame");
    if (iframe) {
      iframe.addEventListener("error", (e) => {
        console.warn("Error en iframe, pero continuando de forma segura");
        e.preventDefault();
      });
    }
  });
</script>
