---
import Layout from '@/ui/layouts/Layout.astro';
import BackButton from '@/ui/components/BackButton.astro';
import { api } from '@/services/api';

const roadmap = await api.getRoadmap();
---

<Layout title="Roadmap de Proyectos - Diego Quintana">
  <main class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50 to-purple-50 dark:from-gray-900 dark:via-blue-900 dark:to-purple-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Back Button - Positioned to the left -->
      <div class="mb-8">
        <BackButton variant='secondary'/>
      </div>
      
      <!-- Header -->
      <div class="text-left mb-12">
        <h1 class="text-4xl md:text-6xl font-bold mb-4 text-gray-800 dark:text-gray-100">
          <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent flex gap-3">
           
            Roadmap de Proyectos
          </span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Plan estratégico de evolución técnica enfocado en <strong>desarrollo de audio profesional</strong>, 
          <strong>inteligencia artificial aplicada</strong> y <strong>tecnologías de vanguardia</strong>. 
          Un recorrido progresivo desde plugins VST hasta soluciones comerciales multiplataforma.
        </p>
      </div>

      <!-- Timeline Container -->
      <div class="max-w-6xl mx-auto">
        <div class="relative">
          <!-- Timeline Line -->
          <div class="absolute left-8 md:left-1/2 transform md:-translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-purple-500 to-blue-500"></div>

          <!-- Projects -->
          <div class="space-y-12">
            {roadmap.map((project, index) => (
              <div class={`relative flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                <!-- Timeline Dot -->
                <div class="absolute left-8 md:left-1/2 transform -translate-x-1/2 w-4 h-4 rounded-full border-4 border-white dark:border-gray-900 z-10" 
                     class:list={[
                       project.status === 'completed' && 'bg-green-500',
                       project.status === 'in-progress' && 'bg-yellow-500',
                       project.status === 'not-started' && 'bg-gray-400',
                       project.status === 'paused' && 'bg-red-500'
                     ]}>
                </div>

                <!-- Project Card -->
                <div class={`w-full md:w-5/12 ${index % 2 === 0 ? 'md:mr-auto md:pr-8' : 'md:ml-auto md:pl-8'} ml-16 md:ml-0`}>
                  <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl p-6 border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-xl transition-all duration-300">
                    
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex items-center gap-3">
                        <div class={`w-3 h-3 rounded-full`} 
                             class:list={[
                               project.status === 'completed' && 'bg-green-500',
                               project.status === 'in-progress' && 'bg-yellow-500',
                               project.status === 'not-started' && 'bg-gray-400',
                               project.status === 'paused' && 'bg-red-500'
                             ]}>
                        </div>
                        <span class={`text-xs font-medium px-2 py-1 rounded-full`}
                              class:list={[
                                project.category === 'audio' && 'bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300',
                                project.category === 'web' && 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300',
                                project.category === 'ai' && 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300',
                                project.category === 'infrastructure' && 'bg-gray-100 text-gray-700 dark:bg-gray-900 dark:text-gray-300'
                              ]}>
                          {project.category.toUpperCase()}
                        </span>
                      </div>
                      <span class={`text-xs font-medium px-2 py-1 rounded-full`}
                            class:list={[
                              project.priority === 'high' && 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300',
                              project.priority === 'medium' && 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300',
                              project.priority === 'low' && 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300'
                            ]}>
                        {project.priority} priority
                      </span>
                    </div>

                    <!-- Title & Description -->
                    <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-2">
                      {project.title}
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm mb-4 leading-relaxed">
                      {project.description}
                    </p>

                    <!-- Timeline Info -->
                    <div class="flex items-center justify-between mb-4 text-xs text-gray-500 dark:text-gray-400">
                      <span>📅 {project.startDate || 'Sin definir'}</span>
                      <span>⏱️ {project.estimatedDuration}</span>
                    </div>

                    <!-- Technologies -->
                    <div class="mb-4">
                      <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2">Stack Tecnológico:</h4>
                      <div class="flex flex-wrap gap-1">
                        {project.technologies.map(tech => (
                          <span class="bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-2 py-1 rounded text-xs">
                            {tech}
                          </span>
                        ))}
                      </div>
                    </div>

                    <!-- Learning Goals -->
                    <div class="mb-4">
                      <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2">Objetivos de Aprendizaje:</h4>
                      <ul class="space-y-1">
                        {project.learningGoals.slice(0, 3).map(goal => (
                          <li class="text-xs text-gray-600 dark:text-gray-400 flex items-start gap-2">
                            <span class="text-purple-500">•</span>
                            {goal}
                          </li>
                        ))}
                        {project.learningGoals.length > 3 && (
                          <li class="text-xs text-purple-600 dark:text-purple-400">
                            +{project.learningGoals.length - 3} objetivos más...
                          </li>
                        )}
                      </ul>
                    </div>

                    <!-- Milestones Progress -->
                    {project.milestones && (
                      <div class="mb-4">
                        <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2">Progreso:</h4>
                        <div class="space-y-2">
                          {project.milestones.slice(0, 2).map(milestone => (
                            <div class="flex items-center gap-2">
                              <div class={`w-2 h-2 rounded-full ${milestone.completed ? 'bg-green-500' : 'bg-gray-300'}`}></div>
                              <span class="text-xs text-gray-600 dark:text-gray-400 flex-1">{milestone.title}</span>
                              {milestone.dueDate && (
                                <span class="text-xs text-gray-500">{milestone.dueDate}</span>
                              )}
                            </div>
                          ))}
                          {project.milestones.length > 2 && (
                            <div class="text-xs text-purple-600 dark:text-purple-400 ml-4">
                              +{project.milestones.length - 2} hitos más...
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    <!-- Repository Link -->
                    {project.repository && (
                      <div class="flex items-center gap-2 pt-4 border-t border-gray-200 dark:border-gray-600">
                        <svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"></path>
                        </svg>
                        <a href={project.repository} target="_blank" rel="noopener noreferrer" 
                           class="text-xs text-purple-600 dark:text-purple-400 hover:underline">
                          Ver repositorio
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Summary Stats -->
        <div class="mt-16 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl p-8 border border-gray-200 dark:border-gray-700">
          <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-6">📊 Resumen del Roadmap</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="text-center">
              <div class="text-3xl font-bold text-purple-600">{roadmap.length}</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">Proyectos Totales</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-yellow-600">{roadmap.filter(p => p.status === 'in-progress').length}</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">En Progreso</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-red-600">{roadmap.filter(p => p.priority === 'high').length}</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">Alta Prioridad</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600">~24</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">Meses Estimados</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Timeline responsive adjustments */
  @media (max-width: 768px) {
    .absolute.left-8 {
      left: 2rem;
    }
    .ml-16 {
      margin-left: 4rem;
    }
  }
</style>