---
interface Props {
  class?: string;
  variant?: "primary" | "secondary" | "violet";
}

const { class: className = "", variant = "primary" } = Astro.props;

const variantClasses = {
  primary:
    "bg-gradient-to-br from-blue-500 to-blue-700 text-white border border-transparent hover:from-blue-700 hover:to-blue-800",
  secondary:
    "bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 hover:border-slate-300 hover:text-slate-700 dark-secondary",
  violet:
    "bg-gradient-to-br from-violet-500 to-violet-700 text-white border border-transparent hover:from-violet-600 hover:to-violet-800",
};
---

<a
  href="/"
  class={`inline-flex items-center gap-2 px-6 py-3 rounded-lg shadow-md no-underline font-medium cursor-pointer select-none isolate transition-shadow duration-200 ease-in-out hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:max-sm:w-full sm:max-sm:justify-center btn-scale-animation-full back-button ${variantClasses[variant]} ${className}`}
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="shrink-0 transition-transform duration-200 ease-in-out back-button__icon"
  >
    <path d="m15 18-6-6 6-6"></path>
  </svg>
  <span>Volver</span>
</a>

<style>
  /* Dark theme overrides for secondary variant (not expressible with Tailwind dark: prefix since theme is data-attribute based) */
  :global([data-theme="dark"]) .back-button.dark-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border-color: var(--border-color);
  }

  :global([data-theme="dark"]) .back-button.dark-secondary:hover {
    background: var(--bg-accent);
    border-color: var(--text-secondary);
  }

  :global([data-theme="dark"]) .back-button:focus {
    box-shadow:
      0 0 0 2px var(--bg-primary),
      0 0 0 4px var(--text-accent);
  }

  /* Icon hover translation */
  .back-button:hover .back-button__icon {
    transform: translateX(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-button__icon {
      transition: none;
    }

    .back-button:hover .back-button__icon {
      transform: none;
    }
  }
</style>
