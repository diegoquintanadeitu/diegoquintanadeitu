---
import { api } from "@/services/api";

// Obtener datos del perfil
const profile = await api.getProfile();
---

<footer
  class="relative bottom-0 w-full z-10 overflow-hidden bg-[var(--bg-primary)]"
>
  <!-- Background decorations -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute inset-0 opacity-10 bg-gradient-to-br from-transparent via-[rgba(var(--text-accent-rgb),0.18)] to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: radial-gradient(circle at 2px 2px, var(--text-muted) 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>
  </div>

  <div
    class="relative max-w-[1200px] mx-auto px-8 pt-12 pb-6 max-md:px-4 max-md:pt-8 max-md:pb-4"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-8 max-md:gap-6">
      <!-- Branding -->
      <div
        class="flex flex-col gap-3 p-5 bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-color)] shadow-sm md:p-0 md:bg-transparent md:rounded-none md:border-0 md:shadow-none col-start-1 col-end-3 md:col-end-2"
      >
        <h3
          class="text-2xl font-bold text-[var(--text-primary)] m-0 max-md:text-[1.3rem] max-md:font-extrabold"
        >
          {profile.name}
        </h3>
        <p
          class="text-[var(--text-secondary)] m-0 text-base max-md:text-[0.9rem] max-md:font-medium max-md:opacity-80"
        >
          {profile.role}
        </p>
        <div
          class="flex w-fit items-center gap-2 text-sm text-[var(--text-muted)] bg-[var(--bg-accent)] px-3 py-2 rounded-[20px] border border-[var(--border-color)] text-[0.8rem] font-semibold md:bg-transparent md:px-0 md:py-0 md:rounded-none md:border-0 md:text-sm"
        >
          <div
            class="status-dot w-2 h-2 bg-green-500 rounded-full max-md:w-1.5 max-md:h-1.5"
          >
          </div>
          <span>Disponible</span>
        </div>
      </div>

      <!-- Redes sociales -->
      <div
        class="flex flex-col gap-4 bg-[var(--bg-secondary)] p-5 rounded-2xl border border-[var(--border-color)] shadow-sm md:p-0 md:bg-transparent md:rounded-none md:border-0 md:shadow-none col-start-1 md:col-start-2 col-end-3"
      >
        <h4 class="text-lg font-semibold text-[var(--text-primary)] m-0">
          Contacto
        </h4>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-1">
          <a
            href="https://github.com/diegoquintanadeitu"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link github flex items-center gap-3 px-4 py-3 text-[var(--text-secondary)] no-underline rounded-xl bg-[var(--bg-accent)] border border-[var(--border-color)] transition-all duration-300 ease-in-out hover:-translate-y-0.5 md:bg-[var(--bg-secondary)] md:rounded-lg md:px-3"
          >
            <svg
              class="w-5 h-5 shrink-0 max-md:w-7 max-md:h-7"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"
              ></path>
            </svg>
            <span class="text-sm font-medium">GitHub</span>
          </a>

          <a
            href="https://www.linkedin.com/in/diego-daniel-martin-quintana"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link linkedin flex items-center gap-3 px-4 py-3 text-[var(--text-secondary)] no-underline rounded-xl bg-[var(--bg-accent)] border border-[var(--border-color)] transition-all duration-300 ease-in-out hover:-translate-y-0.5 md:bg-[var(--bg-secondary)] md:rounded-lg md:px-3"
          >
            <svg
              class="w-5 h-5 shrink-0 max-md:w-7 max-md:h-7"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
            <span class="text-sm font-medium">LinkedIn</span>
          </a>

          <a
            href="https://instagram.com/diegoquintanadeitu"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link instagram flex items-center gap-3 px-4 py-3 text-[var(--text-secondary)] no-underline rounded-xl bg-[var(--bg-accent)] border border-[var(--border-color)] transition-all duration-300 ease-in-out hover:-translate-y-0.5 md:bg-[var(--bg-secondary)] md:rounded-lg md:px-3"
          >
            <svg
              class="w-5 h-5 shrink-0 max-md:w-7 max-md:h-7"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path>
            </svg>
            <span class="text-sm font-medium">Instagram</span>
          </a>

          <a
            href="mailto:diegoquintanadeitu@gmail.com"
            class="social-link email flex items-center gap-3 px-4 py-3 text-[var(--text-secondary)] no-underline rounded-xl bg-[var(--bg-accent)] border border-[var(--border-color)] transition-all duration-300 ease-in-out hover:-translate-y-0.5 md:bg-[var(--bg-secondary)] md:rounded-lg md:px-3"
          >
            <svg
              class="w-5 h-5 shrink-0 max-md:w-7 max-md:h-7"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819L11.18 14.71 8.815 16.9H4.636A1.636 1.636 0 0 1 3 15.264V5.457c0-.904.732-1.636 1.636-1.636h16.728c.904 0 1.636.732 1.636 1.636Z"
              ></path>
              <path
                fill="#fff"
                d="M6 7.25c0-.69.56-1.25 1.25-1.25h9.5c.69 0 1.25.56 1.25 1.25s-.56 1.25-1.25 1.25h-9.5C6.56 8.5 6 7.94 6 7.25ZM7.25 10C6.56 10 6 10.56 6 11.25s.56 1.25 1.25 1.25h5.5c.69 0 1.25-.56 1.25-1.25S12.94 10 12.25 10h-5.5Z"
              ></path>
            </svg>
            <span class="text-sm font-medium">Email</span>
          </a>
        </div>
      </div>

      <!-- Footer bottom -->
      <div
        class="pt-6 border-t border-[var(--border-color)] text-center"
        style="grid-column: span 2; max-width: 600px; margin-left: auto; margin-right: auto;"
      >
        <p class="text-[var(--text-muted)] text-sm m-0">
          © {new Date().getFullYear()}
          {profile.name}. Creado con <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-accent)] no-underline font-medium transition-opacity duration-300 ease-in-out hover:opacity-80 hover:underline"
            >Astro</a
          >.
        </p>
      </div>
    </div>
  </div>

  <style>
    /* Status dot pulse animation */
    .status-dot {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    /* Social link branded hover colors */
    .social-link.github:hover {
      background: #24292e;
      color: white;
      border-color: #24292e;
    }

    .social-link.linkedin:hover {
      background: #0077b5;
      color: white;
      border-color: #0077b5;
    }

    .social-link.instagram:hover {
      background: linear-gradient(
        45deg,
        #f09433 0%,
        #e6683c 25%,
        #dc2743 50%,
        #cc2366 75%,
        #bc1888 100%
      );
      color: white;
      border-color: #e1306c;
    }

    .social-link.email:hover {
      background: #ea4335;
      color: white;
      border-color: #ea4335;
    }
  </style>
</footer>
