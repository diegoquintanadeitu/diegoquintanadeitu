<div class="fixed top-4 right-4 z-[9999] isolate animate-slide-in-right">
  <div class="relative">
    <!-- Botón principal -->
    <button
      id="theme-toggle"
      class="theme-selector__toggle flex items-center justify-center w-12 h-12 bg-white dark:bg-slate-800 backdrop-blur-xl border border-black dark:border-white rounded-full shadow-md cursor-pointer select-none transition-all duration-200 ease-in-out hover:bg-white dark:hover:bg-slate-700 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 btn-scale-animation-full"
      title="Cambiar tema"
      aria-label="Selector de tema"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <svg
        id="theme-icon"
        class="w-5 h-5 text-gray-700 dark:text-slate-200 transition-all duration-200 ease-in-out"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
        ></path>
      </svg>
    </button>

    <!-- Menú desplegable -->
    <div
      id="theme-menu"
      class="theme-selector__menu absolute top-[calc(100%+1rem)] right-0 bg-white dark:bg-slate-800 backdrop-blur-xl border border-black dark:border-white rounded-xl shadow-2xl p-2 min-w-[10rem] flex flex-col gap-1 opacity-0 invisible scale-95 -translate-y-2 origin-top-right transition-all duration-200 ease-in-out"
      role="menu"
      aria-labelledby="theme-toggle"
    >
      <button
        id="theme-dark"
        class="theme-selector__option flex items-center gap-3 w-full px-3 py-3 bg-transparent border-none rounded-lg text-left cursor-pointer select-none transition-all duration-150 ease-in-out hover:bg-blue-500 hover:text-blue-800 dark:hover:bg-sky-300 dark:hover:text-sky-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset"
        data-theme="dark"
        role="menuitem"
      >
        <div
          class="theme-selector__indicator w-4 h-4 rounded-full border border-black shrink-0 transition-transform duration-200 ease-in-out bg-gradient-to-br from-gray-700 to-gray-900"
        >
        </div>
        <span class="text-sm font-medium leading-tight">Tema Oscuro</span>
      </button>
      <button
        id="theme-light"
        class="theme-selector__option flex items-center gap-3 w-full px-3 py-3 bg-transparent border-none rounded-lg text-left cursor-pointer select-none transition-all duration-150 ease-in-out hover:bg-blue-500 hover:text-blue-800 dark:hover:bg-sky-300 dark:hover:text-sky-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset"
        data-theme="light"
        role="menuitem"
      >
        <div
          class="theme-selector__indicator w-4 h-4 rounded-full border border-black shrink-0 transition-transform duration-200 ease-in-out bg-gradient-to-br from-blue-400 to-emerald-400"
        >
        </div>
        <span class="text-sm font-medium leading-tight">Tema Claro</span>
      </button>

      <button
        id="theme-sepia"
        class="theme-selector__option flex items-center gap-3 w-full px-3 py-3 bg-transparent border-none rounded-lg text-left cursor-pointer select-none transition-all duration-150 ease-in-out hover:bg-amber-500 hover:text-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-inset"
        data-theme="sepia"
        role="menuitem"
      >
        <div
          class="theme-selector__indicator w-4 h-4 rounded-full border border-black shrink-0 transition-transform duration-200 ease-in-out bg-gradient-to-br from-amber-300 to-amber-700"
        >
        </div>
        <span class="text-sm font-medium leading-tight">Tema Sepia</span>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const validThemes = ["dark", "light", "sepia"] as const;
    type themeType = (typeof validThemes)[number];
    const defaultTheme: themeType = "dark";

    const isValidTheme = (value: string | null): value is themeType =>
      Boolean(value && validThemes.includes(value as themeType));

    const normalizeTheme = (value: string | null): themeType =>
      isValidTheme(value) ? value : defaultTheme;

    const themeToggle = document.getElementById("theme-toggle");
    const themeMenu = document.getElementById("theme-menu");
    const themeIcon = document.getElementById("theme-icon");
    const themeOptions = document.querySelectorAll<HTMLButtonElement>(
      ".theme-selector__option",
    );
    const body = document.body;
    const root = document.documentElement;

    let isMenuOpen = false;

    console.log("🚀 ThemeSelector inicializado");
    console.log(`📋 Opciones encontradas: ${themeOptions.length}`);

    // Cargar tema guardado
    const rawTheme = localStorage.getItem("portfolio-theme");
    const savedTheme = normalizeTheme(rawTheme);
    console.log(`💾 Tema guardado: ${rawTheme} -> ${savedTheme}`);
    setTheme(savedTheme);

    // Toggle del menú
    themeToggle?.addEventListener("click", function (e) {
      e.stopPropagation();
      toggleMenu();
    });

    // Cerrar menú al hacer click fuera
    document.addEventListener("click", function () {
      if (isMenuOpen) {
        closeMenu();
      }
    });

    // Prevenir cierre al hacer click en el menú
    themeMenu?.addEventListener("click", function (e) {
      e.stopPropagation();
    });

    // Opciones de tema
    themeOptions.forEach((option, index) => {
      console.log(`🔧 Configurando opción ${index}:`, option);
      option.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const target = e.currentTarget as HTMLButtonElement;
        const rawTheme = target.getAttribute("data-theme");

        if (!isValidTheme(rawTheme)) {
          console.error(`❌ Tema inválido: ${rawTheme}`);
          return;
        }

        const theme: themeType = rawTheme;

        console.log(`🎨 Click en tema: ${theme}`);
        console.log(`📍 Target:`, target);

        setTheme(theme);
        closeMenu();
      });
    });

    function toggleMenu() {
      if (isMenuOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    function openMenu() {
      console.log("📂 Abriendo menú");
      isMenuOpen = true;
      themeMenu?.classList.add("is-open");
      themeToggle?.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      console.log("📁 Cerrando menú");
      isMenuOpen = false;
      themeMenu?.classList.remove("is-open");
      themeToggle?.setAttribute("aria-expanded", "false");
    }
    function setTheme(theme: themeType) {
      console.log(`🔄 Aplicando tema: ${theme}`);

      // Mantener el mismo estado de tema en html y body para Tailwind y CSS custom.
      root.classList.toggle("dark", theme === "dark");
      root.classList.toggle("sepia", theme === "sepia");
      root.setAttribute("data-theme", theme);
      body.setAttribute("data-theme", theme);

      // Guardar en localStorage
      localStorage.setItem("portfolio-theme", theme);

      // Actualizar UI
      updateIcon(theme);
      updateActiveOption(theme);

      console.log(`✅ Tema ${theme} aplicado correctamente`);
    }

    function updateIcon(theme: themeType) {
      if (!themeIcon) return;

      const icons = {
        light: `<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'></path>`,
        dark: `<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'></path>`,
        sepia: `<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'></path>`,
      };

      themeIcon.innerHTML = icons[theme] || icons.light;
    }

    function updateActiveOption(theme: string) {
      const inactiveColor = theme === "dark" ? "#ffffff" : "#374151";
      const activeColor =
        theme === "dark"
          ? "#7dd3fc"
          : theme === "sepia"
            ? "#374151"
            : "#1e40af";

      themeOptions.forEach((option) => {
        const button = option as HTMLButtonElement;
        button.classList.remove("is-active");
        button.style.color = inactiveColor;

        if (button.getAttribute("data-theme") === theme) {
          button.classList.add("is-active");
          button.style.color = activeColor;
        }
      });
    }
  });
</script>

<style>
  /* Menu open state */
  .theme-selector__menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: scale(1) translateY(0);
  }

  /* Active option state */
  .theme-selector__option {
    color: #374151;
  }

  .theme-selector__option span {
    color: inherit;
  }

  :global([data-theme="dark"]) .theme-selector__option {
    color: #ffffff;
  }

  :global([data-theme="sepia"]) .theme-selector__option {
    color: #374151;
  }

  .theme-selector__option.is-active {
    background: rgba(59, 130, 246, 0.1);
    color: #1e40af;
    font-weight: 500;
  }

  :global([data-theme="dark"]) .theme-selector__option.is-active {
    background: rgba(125, 211, 252, 0.15);
    color: #7dd3fc;
  }

  :global([data-theme="sepia"]) .theme-selector__option.is-active {
    background: rgba(180, 120, 40, 0.12);
    color: #374151;
    font-weight: 500;
  }

  /* Icon hover rotation */
  .theme-selector__toggle:hover svg {
    transform: rotate(15deg);
  }

  /* Indicator hover scale */
  .theme-selector__option:hover .theme-selector__indicator {
    transform: scale(1.1);
  }

  /* Entry animation */
  @keyframes slide-in-right {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .animate-slide-in-right {
    animation: slide-in-right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (max-width: 480px) {
    .theme-selector__toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media print {
    .animate-slide-in-right {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in-right {
      animation: none;
    }

    .theme-selector__toggle svg,
    .theme-selector__menu,
    .theme-selector__option,
    .theme-selector__indicator {
      transition: none;
    }

    .theme-selector__toggle:hover svg,
    .theme-selector__option:hover .theme-selector__indicator {
      transform: none;
    }
  }
</style>
