---
import "@/global.css";
import Footer from "@/ui/components/Footer.astro";
import ThemeSelector from "@/ui/components/ThemeSelector.astro";

interface Props {
  title: string;
  showFooter?: boolean;
  showSpotify?: boolean;
  showThemeSelector?: boolean;
}

const {
  title,
  showFooter = true,
  showSpotify = true,
  showThemeSelector = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="m-0 w-full h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="m-0 w-full h-full">
    <slot />
    {showFooter && <Footer showSpotify={showSpotify} />}
    {showThemeSelector && <ThemeSelector />}
  </body>
</html>
