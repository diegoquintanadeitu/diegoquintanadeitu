---
import "@/global.css";
import Footer from "@/ui/components/Footer.astro";
import ThemeSelector from "@/ui/components/ThemeSelector.astro";

interface Props {
  title: string;
  description?: string;
  showThemeSelector?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description,
  showThemeSelector = true,
  showFooter = true,
} = Astro.props;

const siteUrl = "https://diegoquintanadeitu.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogDescription =
  description ??
  "Diego Daniel Martin Quintana, Desarrollador Full Stack especializado en TypeScript, React y Next.js";
---

<!doctype html>
<html lang="es" class="m-0 w-full h-full">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KXEY6LDJWX"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-KXEY6LDJWX");
    </script>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={ogDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <script is:inline>
      (() => {
        const rawTheme = localStorage.getItem("portfolio-theme");
        const validThemes = ["dark", "light", "sepia"];
        const theme =
          rawTheme && validThemes.includes(rawTheme) ? rawTheme : "dark";

        const root = document.documentElement;
        root.classList.toggle("dark", theme === "dark");
        root.classList.toggle("sepia", theme === "sepia");
        root.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="m-0 w-full h-full">
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-58P29XGK"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <a
      href="https://github.com/diegoquintanadeitu/diegoquintanadeitu.github.io"
      target="_blank"
      rel="noopener noreferrer"
      title="Ver código fuente en GitHub — Open Source"
      aria-label="Ver repositorio en GitHub"
      class="fixed top-4 right-18 z-[9999] flex items-center justify-center w-11 h-11 bg-white dark:bg-slate-800 border border-black dark:border-white rounded-full shadow-md transition-all duration-200 ease-in-out hover:shadow-lg hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 animate-slide-in-right"
    >
      <svg
        class="w-5 h-5 text-gray-700 dark:text-slate-200"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
    </a>
    <slot />
    {showFooter && <Footer />}
    {showThemeSelector && <ThemeSelector />}
  </body>
</html>
