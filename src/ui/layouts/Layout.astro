---
import "@/global.css";
import Footer from "@/ui/components/Footer.astro";
import ThemeSelector from "@/ui/components/ThemeSelector.astro";

interface Props {
  title: string;
  showFooter?: boolean;
  showSpotify?: boolean;
  showThemeSelector?: boolean;
}

const {
  title,
  showFooter = true,
  showSpotify = true,
  showThemeSelector = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/diegoquintanadeitu/favicon.svg"
    />
    <title>{title}</title>
  </head>
</html>
<body>
  <slot />
  {showFooter && <Footer showSpotify={showSpotify} />}
  {showThemeSelector && <ThemeSelector />}
</body>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
